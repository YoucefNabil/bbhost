#version 460
// DLAA's camera motion vectors (dlaa.cpp): each pixel's depth taken back to
// the world and forward through the previous frame's camera, in pixels,
// previous minus current, as DLSS reads them. One matrix does it: the
// previous ViewProj times the camera's move times the inverse of this
// frame's ViewProj, built on the CPU in double. The depth was drawn with
// this frame's jitter (a viewport shift), so a pixel centre stands for the
// unjittered position centre - jitter.
//
// Compiled offline (tools/build_shaders.sh) into dlaa_mv.spv.h.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r32f) uniform readonly image2D depth;
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D motion;

layout(push_constant) uniform Params {
    mat4 reproject;  // current NDC (x, y up, depth 0..1, 1) -> previous clip
    vec2 jitter;     // pixels, x right, y down
    uvec2 size;
    uint zero;       // 1: write zero motion (Ctrl+F4)
};

void main() {
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= int(size.x) || xy.y >= int(size.y)) return;
    vec2 mv = vec2(0.0);
    if (zero == 0u) {
        const vec2 dims = vec2(size);
        const vec2 p = vec2(xy) + 0.5 - jitter;
        const float z = imageLoad(depth, xy).r;
        const vec4 ndc = vec4(2.0 * p.x / dims.x - 1.0, 1.0 - 2.0 * p.y / dims.y, z, 1.0);
        const vec4 prev = reproject * ndc;
        if (prev.w > 1e-6) {
            const vec2 q = prev.xy / prev.w;
            mv = vec2((q.x + 1.0) * 0.5 * dims.x, (1.0 - q.y) * 0.5 * dims.y) - p;
        }
    }
    imageStore(motion, xy, vec4(mv, 0.0, 0.0));
}
